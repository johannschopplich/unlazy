{
  "name": "@unlazy/react",
  "type": "module",
  "version": "3.0.0",
  "description": "React component for native image lazy loading with BlurHash and ThumbHash placeholders",
  "author": "Johann Schopplich <hello@johannschopplich.com>",
  "license": "MIT",
  "homepage": "https://unlazy.byjohann.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johannschopplich/unlazy.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/johannschopplich/unlazy/issues"
  },
  "keywords": [
    "blurhash",
    "lazy",
    "loading",
    "lozad",
    "placeholder",
    "responsive",
    "thumbhash",
    "react"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "vite playground",
    "dev:build": "vite build playground",
    "test:types": "tsc",
    "test:build": "publint --strict && attw --pack --profile esm-only"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "dependencies": {
    "unlazy": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:",
    "vitest-browser-react": "catalog:"
  }
}
