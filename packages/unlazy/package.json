{
  "name": "unlazy",
  "type": "module",
  "version": "3.0.1",
  "description": "Native image lazy loading with BlurHash and ThumbHash placeholders and auto-calculated sizes, without a framework",
  "author": "Johann Schopplich <hello@johannschopplich.com>",
  "license": "MIT",
  "homepage": "https://unlazy.byjohann.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johannschopplich/unlazy.git",
    "directory": "packages/unlazy"
  },
  "bugs": {
    "url": "https://github.com/johannschopplich/unlazy/issues"
  },
  "keywords": [
    "blurhash",
    "lazy",
    "loading",
    "lozad",
    "placeholder",
    "responsive",
    "thumbhash"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.development.js",
      "default": "./dist/index.js"
    },
    "./blurhash": {
      "types": "./dist/blurhash.d.ts",
      "default": "./dist/blurhash.js"
    },
    "./thumbhash": {
      "types": "./dist/thumbhash.d.ts",
      "default": "./dist/thumbhash.js"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/unlazy.iife.js",
  "jsdelivr": "./dist/unlazy.iife.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test:types": "tsc",
    "test:build": "publint --strict && attw --pack --profile esm-only"
  },
  "devDependencies": {
    "fast-blurhash": "catalog:",
    "thumbhash": "catalog:"
  }
}
