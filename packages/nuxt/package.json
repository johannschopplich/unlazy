{
  "name": "@unlazy/nuxt",
  "type": "module",
  "version": "3.0.1",
  "description": "Nuxt module for native image lazy loading with BlurHash and ThumbHash placeholders, decoded on the server",
  "author": "Johann Schopplich <hello@johannschopplich.com>",
  "license": "MIT",
  "homepage": "https://unlazy.byjohann.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johannschopplich/unlazy.git",
    "directory": "packages/nuxt"
  },
  "bugs": {
    "url": "https://github.com/johannschopplich/unlazy/issues"
  },
  "keywords": [
    "blurhash",
    "lazy",
    "loading",
    "lozad",
    "placeholder",
    "responsive",
    "thumbhash",
    "nuxt"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "default": "./dist/module.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev": "nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "test:types": "vue-tsc",
    "test:build": "publint --strict"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "@unlazy/vue": "workspace:*",
    "defu": "catalog:",
    "unlazy": "workspace:*"
  },
  "devDependencies": {
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@unocss/nuxt": "catalog:",
    "@unocss/reset": "catalog:",
    "nuxt": "catalog:"
  }
}
